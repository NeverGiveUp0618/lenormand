[{"n":1,"name":"骑士","en":"Rider","pk":"红桃9","pol":1,"gist":"消息在路上。带来外部动静的第一张牌，快而轻。","role":"报信牌，本身不好不坏，好坏看它带来的下一张。","noun":["消息","来访者","快递","运动","年轻男子"],"adj":["迅速的","年轻的","外来的"],"verb":["到来","传递","接近"],"adv":["很快地","主动地"],"people":["信使","快递员","运动员","来访的年轻人"],"time":"很快，一两天内","keys":["消息","到来","速度"]},{"n":2,"name":"三叶草","en":"Clover","pk":"方块6","pol":1,"gist":"小而短暂的好运，机会窗口开一条缝。","role":"正面牌，但分量轻、时效短，不承诺长久。","noun":["小幸运","机会","赌注","小惊喜"],"adj":["幸运的","短暂的","轻松的"],"verb":["碰巧","侥幸","撞上"],"adv":["恰好","暂时地"],"people":["赌徒","乐天派","运气好的人"],"time":"很短，几小时到几天","keys":["小幸运","机会","短暂"]},{"n":3,"name":"船","en":"Ship","pk":"黑桃10","pol":1,"gist":"离开此地去向远方，也指跨地域的往来与贸易。","role":"温和正面，强调距离与移动。","noun":["旅行","远方","外国","贸易","车辆"],"adj":["遥远的","异国的","流动的"],"verb":["出发","远行","运输"],"adv":["向远处","渐渐地"],"people":["旅人","外国人","海员","贸易商"],"time":"一段路程的时间，数周","keys":["旅行","远方","贸易"]},{"n":4,"name":"房屋","en":"House","pk":"红桃K","pol":1,"gist":"家、家人、房产，也是一切私域与稳定的根基。","role":"正面牌，把事情往「自己人、自家地盘」上收。","noun":["家","住宅","家庭","房产","私事"],"adj":["安稳的","私人的","熟悉的"],"verb":["安顿","居住","归属"],"adv":["在家里","稳妥地"],"people":["家人","房东","本地人"],"time":"稳定持续，按月计","keys":["家","房产","稳定"]},{"n":5,"name":"树","en":"Tree","pk":"红桃7","pol":1,"gist":"身体与生命力，长得慢但扎根深。","role":"中性偏正，主健康、根源、成长速度慢。","noun":["健康","身体","根源","成长","血缘"],"adj":["缓慢的","深远的","自然的"],"verb":["生长","扎根","恢复"],"adv":["慢慢地","逐渐地"],"people":["医生","长辈","血亲","治疗师"],"time":"慢，数月甚至更久","keys":["健康","成长","缓慢"]},{"n":6,"name":"云","en":"Clouds","pk":"梅花K","pol":-1,"gist":"看不清、拿不准，暂时性的迷雾与烦扰。","role":"负面牌，且有方向性：暗的一侧指向的那张牌受影响更重。","noun":["困惑","不确定","误会","阴影"],"adj":["模糊的","混乱的","不稳的"],"verb":["遮蔽","动摇","犹疑"],"adv":["含糊地","暂时地"],"people":["态度不明的人","让人看不透的人"],"time":"很快过去，但期间难判断","keys":["困惑","不明","暂时"]},{"n":7,"name":"蛇","en":"Snake","pk":"梅花Q","pol":-1,"gist":"事情不走直线，绕、缠、别有用心。","role":"负面牌，也常代表当事人之外的另一个女性。","noun":["弯路","纠缠","欺骗","另一个女人"],"adj":["复杂的","迂回的","有心机的"],"verb":["绕开","缠住","算计"],"adv":["拐弯抹角地"],"people":["精明的女性","竞争者","心机重的人"],"time":"拖延、反复","keys":["弯路","欺骗","复杂"]},{"n":8,"name":"棺材","en":"Coffin","pk":"方块9","pol":-1,"gist":"到此为止。一段东西结束、关闭、转入静止。","role":"强负面牌，主终结、疾病、低潮；结束之后才有新开始。","noun":["结束","丧失","疾病","低谷"],"adj":["终结的","停滞的","沉重的"],"verb":["结束","关闭","放下"],"adv":["彻底地","不可逆地"],"people":["病人","离开的人"],"time":"一个阶段的收尾","keys":["结束","丧失","停滞"]},{"n":9,"name":"花束","en":"Bouquet","pk":"黑桃Q","pol":1,"gist":"来自他人的好意：礼物、邀请、被欣赏。","role":"正面牌，主美好、体面、令人愉快的表面。","noun":["礼物","邀请","美","赞赏","客气"],"adj":["美的","讨喜的","得体的"],"verb":["赠予","邀请","装点"],"adv":["愉快地","漂亮地"],"people":["优雅的女性","送礼的人","客人"],"time":"近期的一个愉快时刻","keys":["礼物","邀请","美"]},{"n":10,"name":"镰刀","en":"Scythe","pk":"方块J","pol":-1,"gist":"一刀切下去，快、痛、不回头。","role":"负面牌，主突然、切断、危险；有刃口方向。","noun":["切断","决断","手术","意外","收割"],"adj":["突然的","锋利的","危险的"],"verb":["切断","中止","决裂"],"adv":["猝然地","干脆地"],"people":["外科医生","下狠手的人","农人"],"time":"就在当下，瞬间","keys":["切断","突然","危险"]},{"n":11,"name":"鞭子","en":"Whip","pk":"梅花J","pol":-1,"gist":"反复来回的力：吵架、训练、体力活、性。","role":"负面牌，核心是「重复」与「施力」。","noun":["争吵","重复","锻炼","体力活","性"],"adj":["重复的","激烈的","严厉的"],"verb":["争执","反复做","逼迫"],"adv":["一遍遍地","激烈地"],"people":["爱吵的人","教练","严师","体力劳动者"],"time":"反复发生，持续一段","keys":["争吵","重复","施压"]},{"n":12,"name":"鸟","en":"Birds","pk":"方块7","pol":0,"gist":"两只鸟在说话：口头交流、成双、以及说个不停带来的心慌。","role":"中性偏负，主口舌、短促、焦虑，也表「两个」。","noun":["谈话","电话","两个","闲言","焦虑"],"adj":["聒噪的","成对的","不安的"],"verb":["交谈","打电话","议论"],"adv":["紧张地","叽喳地"],"people":["两个人","爱说话的人","老年夫妇"],"time":"很短，几小时","keys":["交谈","两个","焦虑"]},{"n":13,"name":"小孩","en":"Child","pk":"黑桃J","pol":1,"gist":"新的、小的、刚开头的，也天真、缺经验。","role":"正面偏轻，把相邻牌「缩小」或「变新」。","noun":["孩子","新开始","小事","天真"],"adj":["新的","小的","单纯的"],"verb":["起步","初学","变小"],"adv":["刚刚地","一点点地"],"people":["孩子","新人","小个子的人"],"time":"刚开始，很近","keys":["新开始","小","天真"]},{"n":14,"name":"狐狸","en":"Fox","pk":"梅花9","pol":-1,"gist":"为自己算计。既是工作谋生，也是提防陷阱。","role":"负面牌，主自利、狡猾、错位；在职业问题里常直指工作本身。","noun":["工作","狡计","陷阱","自我保护"],"adj":["狡猾的","精明的","不诚的"],"verb":["谋算","提防","伪装"],"adv":["暗中地","机敏地"],"people":["同事","骗子","精明的人"],"time":"看时机行事","keys":["工作","狡猾","警觉"]},{"n":15,"name":"熊","en":"Bear","pk":"梅花10","pol":0,"gist":"块头大的力量：靠山、上位者、财力，也可能压人。","role":"中性，量大、力强；常指母亲或上司。","noun":["力量","上司","母亲","财力","体格"],"adj":["强大的","庞大的","有分量的"],"verb":["掌控","保护","压制"],"adv":["强势地","大量地"],"people":["母亲","老板","有权势的人","壮硕的人"],"time":"长期存在的力量","keys":["力量","上司","财力"]},{"n":16,"name":"星星","en":"Stars","pk":"红桃6","pol":1,"gist":"夜里看得见方向：指引、希望、铺开成网。","role":"正面牌，主清晰、灵性、扩散与名气。","noun":["指引","希望","网络","理想","名声"],"adj":["清晰的","众多的","有灵感的"],"verb":["指引","照亮","铺展"],"adv":["清楚地","广泛地"],"people":["有名的人","引路人","星象/灵性工作者"],"time":"夜里；较长的一段光景","keys":["指引","希望","清晰"]},{"n":17,"name":"鹳鸟","en":"Stork","pk":"红桃Q","pol":1,"gist":"迁徙的鸟：位置变了，或者旧的东西回来了。","role":"正面牌，主变化、搬迁、生育、回归。","noun":["变化","搬家","回归","生育"],"adj":["变动的","往返的","更新的"],"verb":["改变","迁移","返回"],"adv":["重新地","来回地"],"people":["搬家的人","孕妇","归来者"],"time":"季节交替；数周内","keys":["变化","迁移","回归"]},{"n":18,"name":"狗","en":"Dog","pk":"红桃10","pol":1,"gist":"跟着你的人。忠诚、熟悉、靠得住。","role":"正面牌，主友谊与信任。","noun":["朋友","忠诚","陪伴","信任"],"adj":["忠实的","友好的","可靠的"],"verb":["跟随","陪伴","支持"],"adv":["忠心地","一直地"],"people":["朋友","伙伴","忠实的下属"],"time":"长期陪伴","keys":["朋友","忠诚","可靠"]},{"n":19,"name":"塔","en":"Tower","pk":"黑桃6","pol":0,"gist":"高而独立的建筑：机构、规矩、界限，也意味着一个人待着。","role":"中性，主官方、孤立、久远。","noun":["机构","公司","孤立","界限","过去"],"adj":["正式的","孤单的","高的","陈旧的"],"verb":["设界","独处","立规"],"adv":["正式地","独自地"],"people":["官方人员","独居者","上层管理"],"time":"长久、由来已久","keys":["机构","孤立","界限"]},{"n":20,"name":"花园","en":"Garden","pk":"黑桃8","pol":1,"gist":"人多的地方：社交场合、公众、大家都看得见。","role":"正面牌，把事情从私下推到台面上。","noun":["公众","聚会","社交","场合","大众"],"adj":["公开的","热闹的","众人的"],"verb":["聚会","公开","交际"],"adv":["公开地","当众"],"people":["公众","一群人","社交达人"],"time":"在某个场合发生","keys":["公众","社交","公开"]},{"n":21,"name":"山","en":"Mountain","pk":"梅花8","pol":-1,"gist":"挡在前面搬不动的东西。慢、冷、远。","role":"强负面牌，主阻碍、延迟、隔阂。","noun":["阻碍","延迟","距离","冷淡"],"adj":["困难的","遥远的","冷的","坚固的"],"verb":["阻挡","拖延","隔开"],"adv":["艰难地","迟迟地"],"people":["难缠的人","冷淡的人","挡路者"],"time":"长期拖延","keys":["阻碍","延迟","冷"]},{"n":22,"name":"道路","en":"Ways","pk":"方块Q","pol":0,"gist":"岔路口：不止一个选项，得选。","role":"中性，主选择、多种可能、决定。","noun":["选择","岔路","方案","决定"],"adj":["多个的","可选的","犹豫的"],"verb":["选择","分开","改道"],"adv":["二选一地","另辟地"],"people":["摇摆的人","做选择的人"],"time":"到了该定的时候","keys":["选择","岔路","决定"]},{"n":23,"name":"老鼠","en":"Mice","pk":"梅花7","pol":-1,"gist":"一点点被啃掉：损耗、丢失、消磨。","role":"负面牌，主减少、压力、不洁；会把相邻牌的分量削弱。","noun":["损失","消耗","压力","脏乱","盗窃"],"adj":["渐损的","肮脏的","焦虑的"],"verb":["损耗","丢失","侵蚀"],"adv":["一点点地","悄悄地"],"people":["小偷","让人心累的人"],"time":"持续消耗中","keys":["损耗","丢失","压力"]},{"n":24,"name":"心","en":"Heart","pk":"红桃J","pol":1,"gist":"感情本身：爱、真心、热度。","role":"正面牌，感情类问题的核心牌。","noun":["爱","感情","真心","心脏"],"adj":["深情的","热的","慷慨的"],"verb":["爱","动心","付出"],"adv":["真心地","热情地"],"people":["爱人","热心人","恋爱中的人"],"time":"感情正热时","keys":["爱","感情","真心"]},{"n":25,"name":"戒指","en":"Ring","pk":"梅花A","pol":1,"gist":"一个圈：绑定、约定、循环往复。","role":"正面偏中性，主合约与关系的形式；只管「有没有绑定」，不管好不好。","noun":["承诺","合同","婚姻","循环","关系"],"adj":["约定的","封闭的","重复的"],"verb":["约定","缔结","循环"],"adv":["反复地","正式地"],"people":["伴侣","合伙人","签约方"],"time":"周期性；一年为循环","keys":["承诺","合约","循环"]},{"n":26,"name":"书","en":"Book","pk":"方块10","pol":0,"gist":"合着的书：还没揭开的事，或需要去学的东西。","role":"中性，主秘密与知识；书是打开还是合着，决定藏还是显。","noun":["秘密","知识","学习","资料","未知"],"adj":["隐藏的","专业的","未公开的"],"verb":["隐瞒","学习","研究"],"adv":["秘密地","有据地"],"people":["老师","学生","知情不说的人","专业人士"],"time":"尚未揭晓","keys":["秘密","知识","学习"]},{"n":27,"name":"信","en":"Letter","pk":"黑桃7","pol":0,"gist":"写下来的东西：文件、短信、单据。","role":"中性，主书面沟通；分量比骑士小。","noun":["书信","文件","短消息","单据"],"adj":["书面的","正式的","小额的"],"verb":["书写","通知","记录"],"adv":["白纸黑字地"],"people":["写信的人","文书","联系人"],"time":"很快，一两天","keys":["书面","文件","消息"]},{"n":28,"name":"男人","en":"Man","pk":"红桃A","pol":0,"gist":"问卦的男性本人，或女性问卦时的男伴。","role":"人物牌。位置和朝向决定「他在看什么」。","noun":["男人","当事人","男伴"],"adj":["男性的"],"verb":["（视其相邻牌而定）"],"adv":[],"people":["求问的男性","丈夫/男友","关键男性"],"time":"—","keys":["男性","本人","伴侣"]},{"n":29,"name":"女人","en":"Woman","pk":"黑桃A","pol":0,"gist":"问卦的女性本人，或男性问卦时的女伴。","role":"人物牌。与男人牌的距离常用来看两人关系远近。","noun":["女人","当事人","女伴"],"adj":["女性的"],"verb":["（视其相邻牌而定）"],"adv":[],"people":["求问的女性","妻子/女友","关键女性"],"time":"—","keys":["女性","本人","伴侣"]},{"n":30,"name":"百合","en":"Lily","pk":"黑桃K","pol":1,"gist":"沉静的成熟：家庭安宁、德行、年长的男性，另一层指性。","role":"正面牌，主和睦、纯净、年资；也代表冬天。","noun":["和睦","品德","长者","父亲","性"],"adj":["成熟的","纯净的","安详的","年长的"],"verb":["安定","守德","关照"],"adv":["从容地","体面地"],"people":["父亲","长者","德高望重的人"],"time":"冬天；长久稳定","keys":["成熟","和睦","长者"]},{"n":31,"name":"太阳","en":"Sun","pk":"方块A","pol":2,"gist":"牌组里最亮的一张：成功、能量、事情明朗。","role":"最强正面牌，能把附近的负面牌照亮几分。","noun":["成功","能量","胜利","光明","白天"],"adj":["成功的","温暖的","明确的"],"verb":["成功","照亮","振作"],"adv":["顺利地","明确地"],"people":["赢家","有活力的人","带来光的人"],"time":"白天；很快见分晓","keys":["成功","能量","明朗"]},{"n":32,"name":"月亮","en":"Moon","pk":"红桃8","pol":1,"gist":"被人看见的光：名声与认可，以及情绪的涨落。","role":"正面牌，主荣誉、情绪、周期；时间上常表一个月。","noun":["名声","认可","情绪","夜晚","周期"],"adj":["受认可的","感性的","周期的"],"verb":["认可","显名","起伏"],"adv":["感性地","周期地"],"people":["有声望的人","感性的人","艺术工作者"],"time":"夜晚；约一个月","keys":["名声","情绪","周期"]},{"n":33,"name":"钥匙","en":"Key","pk":"方块8","pol":2,"gist":"锁开了。答案是肯定的，路走得通。","role":"强正面牌，也是最常用的「是」牌；表确定、解决。","noun":["答案","解决","开启","确定"],"adj":["确定的","关键的","开放的"],"verb":["解决","打开","确认"],"adv":["肯定地","必定地"],"people":["关键人物","能拍板的人"],"time":"就是现在，确定发生","keys":["确定","解决","打开"]},{"n":34,"name":"鱼","en":"Fish","pk":"方块K","pol":1,"gist":"成群的鱼：钱、生意、多而流动。","role":"正面牌，财务问题的核心牌；也表独立自主。","noun":["金钱","生意","丰盛","独立"],"adj":["富足的","流动的","大量的"],"verb":["赚取","流通","经营"],"adv":["大量地","自由地"],"people":["商人","老板","自由职业者","有钱人"],"time":"随生意周转","keys":["金钱","生意","丰盛"]},{"n":35,"name":"锚","en":"Anchor","pk":"黑桃9","pol":1,"gist":"抛下去就不动了：稳住、长久、也可能是走不开。","role":"正面偏中性，主稳定、职业、坚持；久了会变成困住。","noun":["稳定","工作","坚持","目标"],"adj":["长期的","牢固的","不动的"],"verb":["稳住","坚持","固定"],"adv":["长久地","牢牢地"],"people":["老员工","靠谱的人","守成者"],"time":"长期，多年","keys":["稳定","长期","工作"]},{"n":36,"name":"十字","en":"Cross","pk":"梅花6","pol":-1,"gist":"扛在身上的担子：苦、责任、也是信仰与命定。","role":"负面牌，牌组最后一张，常表一段经历到此了结。","noun":["负担","苦难","责任","信仰","定数"],"adj":["沉重的","宿命的","虔诚的"],"verb":["承担","受苦","了结"],"adv":["沉重地","注定地"],"people":["受苦的人","有信仰的人","背责任的人"],"time":"一段苦期；将要结束","keys":["负担","宿命","了结"]}]